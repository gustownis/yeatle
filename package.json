{
  "name": "yeatle-desktop",
  "version": "1.11.3",
  "description": "A self-hosted Yeat song guessing game for desktop and browser.",
  "private": true,
  "license": "Unlicense",
  "author": {
    "name": "Yeatle contributors",
    "email": "60524993+gustownis@users.noreply.github.com"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "start": "node server.js",
    "test:1.11": "node scripts/test-1.11.cjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "prepare:release": "node scripts/prepare-release.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.gustownis.yeatle",
    "productName": "Yeatle",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://github.com/gustownis/yeatle/releases/latest/download/"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "package.json",
      "build/**/*",
      "!build/Songs/**/*",
      "config.example.json",
      "era-covers.json",
      "hidden-songs.json",
      "song-edits.json",
      "song-renames.json",
      "song-splits.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "static-cache.cjs",
      "live-control.cjs",
      "stem-catalog.cjs",
      "daily-challenge.cjs",
      "daily-authority.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/favicon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Yeatle-Setup-${version}-windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Yeatle-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Yeatle-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "gustownis <60524993+gustownis@users.noreply.github.com>",
      "artifactName": "Yeatle-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
